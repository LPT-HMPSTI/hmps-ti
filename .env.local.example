# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - HMPSTI STMIK WIDYA UTAMA WEBSITE
# Salin file ini menjadi .env.local: cp .env.local.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTH CONFIGURATION
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional (untuk bypass RLS di route handler server-side jika diperlukan):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. RESEND EMAIL SERVICE (Untuk Notifikasi Pengajuan Karya Mahasiswa)
# Dapatkan API Key di https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (Untuk Upload Cover Karya Mahasiswa)
# Dapatkan dari Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
# ------------------------------------------------------------------------------
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=hmpsti
# Public Development R2 URL atau Custom Domain (contoh: https://pub-xxx.r2.dev)
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# ------------------------------------------------------------------------------
# 4. CANONICAL SITE URL (Untuk Open Graph, Sitemap & SEO Meta)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. ADMIN API SECURITY (Untuk Proteksi Endpoint Internal Delete R2)
# ------------------------------------------------------------------------------
ADMIN_API_SECRET=hmpsti_admin_secure_key_swu

# ------------------------------------------------------------------------------
# 6. UMAMI WEB ANALYTICS (Opsional - Privacy Friendly Analytics)
# Dapatkan Website ID dari dashboard Umami (Cloud atau Self-Hosted)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id_here
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# ------------------------------------------------------------------------------
# 7. IMAGEKIT CDN OPTIMIZER (Opsional — tapi sangat disarankan untuk performa)
#    ImageKit bertindak sebagai CDN optimizer di depan R2 (bukan storage).
#    R2 tetap SATU-SATUNYA storage; database selalu menyimpan URL R2 asli.
#    Konfigurasi manual diperlukan: tambah R2 sebagai External Storage di
#    dashboard ImageKit (Settings → External Storage → S3-Compatible).
# ------------------------------------------------------------------------------
# URL endpoint ImageKit kamu — diekspos ke frontend untuk konversi URL saat render.
# Format: https://ik.imagekit.io/YOUR_IMAGEKIT_ID
# Cara dapat: imagekit.io/dashboard → Developer Options → URL Endpoint
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# URL R2 publik yang sama seperti R2_PUBLIC_URL — diekspos ke frontend agar helper
# lib/imagekit-url.ts bisa mengidentifikasi URL R2 dan mengkonversinya.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Private Key ImageKit — hanya server-only, hanya untuk purge cache saat gambar dihapus.
# Opsional: jika tidak diisi, purge dilewati (tidak ada error).
# Cara dapat: imagekit.io/dashboard → Developer Options → API Keys → Private Key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
